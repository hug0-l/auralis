{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auralis.local/schema/modules.schema.json",
  "title": "Auralis module registry",
  "description": "Every Auralis module and its parameters.  This file is generated by tools/codegen_registry.py from aurcore/schema/params.tsv - do not edit it by hand.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^(_generated|AUR_[A-Z0-9_]+)$"
  },
  "patternProperties": {
    "^AUR_[A-Z0-9_]+$": {
      "$ref": "#/$defs/module"
    }
  },
  "properties": {
    "_generated": {
      "type": "string",
      "description": "The marker that says the file is generated.  JSON has no comment syntax, so the marker is a key; it carries the same 'do not edit' warning as the header of the other artefacts."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "description": "One module of the registry.",
      "additionalProperties": false,
      "required": [
        "code",
        "display_name",
        "category",
        "edition",
        "element",
        "params"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^AUR_[A-Z0-9_]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "Repair",
            "Utility",
            "Measurement",
            "System"
          ]
        },
        "edition": {
          "enum": [
            "standard",
            "advanced"
          ]
        },
        "element": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        }
      }
    },
    "param": {
      "type": "object",
      "description": "One parameter of one module.",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "default",
        "minimum",
        "maximum",
        "unit",
        "choices",
        "group",
        "automatable",
        "stepped",
        "curve",
        "curve_exponent",
        "help",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "description": "The parameter id: its position inside its own module, counted from zero.  The same number is in aurcore/schema/generated.py, aurcore/schema/aur_modules.h and docs/MODULES.md."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "enum"
          ]
        },
        "default": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "group": {
          "type": "string"
        },
        "automatable": {
          "type": "boolean"
        },
        "stepped": {
          "type": "boolean"
        },
        "curve": {
          "enum": [
            "linear",
            "log",
            "taper"
          ]
        },
        "curve_exponent": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "The exponent p of the taper law, v = lo + (hi - lo) * n ** p.  It only means something when the curve is a taper."
        },
        "help": {
          "type": "string",
          "description": "The sentence that says what the parameter does."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The names the parameter had before it was renamed.  A document that carries one of them still loads."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "bool"
              }
            }
          },
          "then": {
            "properties": {
              "minimum": {
                "const": 0
              },
              "maximum": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  }
}
